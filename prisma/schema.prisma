// Prisma schema - Semain Calidad
// Local dev: SQLite (file:./dev.db)
// Production (Vercel + Turso): change DATABASE_URL to libsql://... and use @prisma/adapter-libsql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CalidadItem {
  id              String   @id @default(cuid())
  // Origin info (from Almacen PV or manual)
  pvNumber        String   // PV number from Almacen
  itemNumber      String   // Item line number within the PV
  description     String   // Product description
  quantity        Int      @default(1)
  // Status & time tracking
  status          String   @default("pendiente") // pendiente | en_proceso | completado | enviado
  estimatedDays   Int      @default(7) // Time budget in days for quality check
  // Shipping info (synced from Shipping Notice)
  shippingDate    DateTime? // Fecha que se envió
  shippingStatus  String?   // a_tiempo | tarde | no_enviado
  shippingSynced  Boolean   @default(false)
  // Manual override tracking
  isManual        Boolean   @default(false)
  notes           String?
  // Source tracking
  source          String   @default("manual") // manual | almacen | excel
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pvNumber, itemNumber])
  @@index([pvNumber])
  @@index([status])
  @@index([shippingStatus])
}

model SyncLog {
  id          String   @id @default(cuid())
  source      String   // almacen | shipping
  status      String   // success | error
  message     String
  itemsCount  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Setting {
  id    String   @id @default(cuid())
  key   String   @unique
  value String
}
