// Prisma schema - Semain Calidad
// Estructura basada en el Excel "SEGUIMIENTO A PV.xlsx"
// Una fila por cada item/partida de cada PV.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model CalidadItem {
  id                      String   @id @default(cuid())

  // --- Identificación del item (del Excel / Almacén) ---
  pvNumber                String   // "PV 1290" (con espacio, como en el Excel)
  itemLine                Int      @default(1) // Número de línea/partida dentro del PV
  cliente                 String?  // "HUTCHINSON TRANSFERENCIA..."
  concepto                String   // "MANDRIL CON TAPAS | G90A5-0E020 MANDREL"
  clave                   String?  // "FIX-NVO-01", "MAN-NVO-01"
  cantidad                Int      @default(1) // Cantidad total original

  // --- Fechas y tiempos (del Excel) ---
  fechaPv                 DateTime? // Fecha de la PV
  fechaInicio             DateTime? // Fecha de inicio de producción
  teTexto                 String?  // "3 SEMANAS", "INMEDIATO" (texto del PDF)
  teDias                  Int?     // 21, 35 (TE convertido a días)
  fechaEntregaEstimada    DateTime? // Fecha calculada de entrega
  fechaReprogramada       DateTime? // Si se reprogramó la entrega

  // --- Estado calculado (del Excel) ---
  estado                  String   @default("EN TIEMPO") // ATRASADO | POR VENCER | EN TIEMPO | REVISAR TE | REVISAR | Entregado
  embarque                String?  // "x" si ya se envió

  // --- Shipping (sync desde Shipping Notice) ---
  shippingDate            DateTime? // Fecha real de envío (del Shipping Notice)
  shippingStatus          String?   // a_tiempo | tarde | no_enviado
  shippingSynced          Boolean   @default(false)
  guia                    String?  // Número de guía
  paqueteria              String?  // DHL, ESTAFETA, etc.

  // --- Envíos parciales / rezagos ---
  parentId                String?  // Si es un item "hijo" (parcial), apunta al item padre
  cantidadEnviada         Int      @default(0) // Cuántas piezas se han enviado (acumulado)
  esParcial               Boolean  @default(false) // True si este item es un resto de un parcial
  partialOf               String?  // Referencia al item padre original (para mostrar en UI)

  // --- Metadata ---
  source                  String   @default("manual") // manual | almacen | excel | partial
  isManual                Boolean  @default(false)
  notes                   String?
  archivo                 String?  // "PV1290.pdf"

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([pvNumber, itemLine])
  @@index([pvNumber])
  @@index([estado])
  @@index([shippingStatus])
  @@index([cliente])
  @@index([parentId])
}

model SyncLog {
  id          String   @id @default(cuid())
  source      String   // almacen | shipping | excel
  status      String   // success | error
  message     String
  itemsCount  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Setting {
  id    String   @id @default(cuid())
  key   String   @unique
  value String
}
