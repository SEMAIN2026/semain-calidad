# ============================================================
# Semain Calidad - Environment Variables
# ============================================================
# Copy this file to .env (local dev) or set these in Vercel
# dashboard (Production > Settings > Environment Variables).
# ============================================================

# ---- DATABASE (Turso) ----
# Get these from https://turso.tech/app -> your database
# Local dev uses a local SQLite file (set DATABASE_URL=file:./db/dev.db)
DATABASE_URL="libsql://<your-db-name>-<your-org>.turso.io"
TURSO_AUTH_TOKEN="<your-turso-database-token>"

# ---- ALMACEN API (read-only) ----
# Credentials for https://semain-almacen.vercel.app
ALMACEN_BASE_URL="https://semain-almacen.vercel.app"
ALMACEN_USERNAME="<your-almacen-username>"
ALMACEN_PASSWORD="<your-almacen-password>"

# ---- SHIPPING NOTICE API (read-only) ----
# Credentials for https://semain-shipping-notice.vercel.app
SHIPPING_BASE_URL="https://semain-shipping-notice.vercel.app"
SHIPPING_USERNAME="<your-shipping-username>"
SHIPPING_PASSWORD="<your-shipping-password>"
